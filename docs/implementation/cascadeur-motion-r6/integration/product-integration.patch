+@dataclass(frozen=True)
+class PairContract:
+    scene_context_bytes: bytes
+    graph_dtype_digest: str
+    raw_space: str
+    mesh_ids: tuple[str, str]
+    fixture_bytes: bytes
+    static_inputs_bytes: bytes
+    evidence_bytes: bytes
