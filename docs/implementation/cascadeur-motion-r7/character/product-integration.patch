+def lower_controller_request(request):
+    """Select only code-owned lowering; this does not register a native adapter."""
+    from .skeletal_fk_controller import ADAPTER_ID as FK_ADAPTER_ID, lower_fk_rotation_request
+    if isinstance(request, dict) and request.get("adapter_id") == FK_ADAPTER_ID:
+        return lower_fk_rotation_request(request)
+    return lower_position_request(request)
+
+
+class ObservedControllerRouter:
+    def __init__(self, verified_targets):
+        self._verified_targets = verified_targets
+
+    def controller_targets(self, targets, profile, *, planned_world=None):
+        from .skeletal_fk_controller import ADAPTER_ID as FK_ADAPTER_ID, ObservedFKRotationController
+        if profile.controller_adapter_id == ADAPTER_ID:
+            adapter = IndependentPositionController(self._verified_targets)
+        elif profile.controller_adapter_id == FK_ADAPTER_ID:
+            adapter = ObservedFKRotationController(self._verified_targets)
+        else:
+            raise MotionInputError("RIG_ADAPTER_UNVERIFIED", "no code-owned lowering for this controller")
+        return adapter.controller_targets(targets, profile, planned_world=planned_world)
