diff --git a/cascadeur_side/cascadeur_complete/native_unbaking_binding.py b/cascadeur_side/cascadeur_complete/native_unbaking_binding.py
new file mode 100644
index 0000000000000000000000000000000000000000..e26b9da098e1d6ffe158439e57a582b859a30031
--- /dev/null
+++ b/cascadeur_side/cascadeur_complete/native_unbaking_binding.py
@@ -0,0 +1,228 @@
+"""Bridge plumbing for a code-owned, privately qualified unbaking executor.
+
+This module is not an SDK leaf. The fixed native_installed_unbaking module is
+intentionally absent until its installed action bindings and completion lifetime
+are observed. No wire argument can install a leaf or supply its private handle.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib
+import json
+
+from . import guarded_runtime as guards
+
+_OPERATION = "generation.unbaking"
+_CONTRACT_FIELDS = ("installed_callable_digest", "lowering_digest",
+                    "completion_contract_digest", "postcondition_contract_digest", "qualification_digest")
+_ACTION_IDS = {
+    "prepare_keys_by_fulcrums": "View.AutoInterpolation_Keys",
+    "adjust_keys_and_interpolation": "View.Animation unbaking",
+    "adjust_autoposing_lock_state": "AutoPosingTool.AutoUnlock",
+}
+
+
+def _freeze(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"),
+                      ensure_ascii=False, allow_nan=False).encode()
+
+
+def _sha(value):
+    return (isinstance(value, str) and len(value) == 64
+            and all(character in "0123456789abcdef" for character in value))
+
+
+def _installed_build():
+    from .native_adapters import installed_build
+    return installed_build()
+
+
+class _QualifiedUnbakingAdapter:
+    def __init__(self, leaf, bundle):
+        self._leaf = leaf
+        self._bundle = bundle
+        self._epoch = guards.RUNTIME_EPOCH
+        self._fingerprint = guards.LOADED_FINGERPRINT
+        self.evidence_bytes = leaf.qualification_bytes(bundle)
+        if not isinstance(self.evidence_bytes, bytes) or not self.evidence_bytes:
+            raise ValueError("UNBAKING_PRIVATE_QUALIFICATION_UNAVAILABLE")
+        self.verification = copy.deepcopy(leaf.adapter_verification(bundle))
+        if (not isinstance(self.verification, dict)
+                or self.verification.get("operations") != [_OPERATION]
+                or self.verification.get("evidence_sha256") != hashlib.sha256(self.evidence_bytes).hexdigest()
+                or self.verification.get("runtime_fingerprint") != self._fingerprint
+                or self.verification.get("installed_build") != _installed_build()
+                or self.verification.get("dispatch_semantics") != "synchronous_no_yield"
+                or self.verification.get("identity_stable") is not True):
+            raise ValueError("UNBAKING_PRIVATE_QUALIFICATION_DIFFERS")
+        self._verification_bytes = _freeze(self.verification)
+        self._contracts = self._read_contracts()
+        self._contract_bytes = _freeze(self._contracts)
+        self._consumed = set()
+        self._assert_current()
+
+    observed_build = staticmethod(_installed_build)
+
+    def _read_contracts(self):
+        from .native_unbaking import STEPS
+        result = self._leaf.step_contracts(self._bundle)
+        if not isinstance(result, dict) or not result or not set(result) <= STEPS:
+            raise ValueError("UNBAKING_PRIVATE_STEP_CONTRACTS_UNAVAILABLE")
+        for step, contract in result.items():
+            if (not isinstance(contract, dict) or contract.get("step") != step
+                    or contract.get("action_id") != _ACTION_IDS[step]
+                    or contract.get("runtime_epoch") != self._epoch
+                    or contract.get("runtime_fingerprint") != self._fingerprint
+                    or contract.get("installed_build") != _installed_build()
+                    or contract.get("dispatch_semantics") != "synchronous_no_yield"
+                    or any(not _sha(contract.get(name)) for name in _CONTRACT_FIELDS)):
+                raise ValueError("UNBAKING_PRIVATE_STEP_CONTRACT_DIFFERS: " + step)
+        return copy.deepcopy(result)
+
+    def _assert_current(self):
+        guards.assert_loaded_package()
+        if (self._epoch != guards.RUNTIME_EPOCH or self._fingerprint != guards.LOADED_FINGERPRINT
+                or self._leaf.bundle_is_current(self._bundle) is not True
+                or self._leaf.qualification_bytes(self._bundle) != self.evidence_bytes
+                or _freeze(self.verification) != self._verification_bytes
+                or _freeze(self._leaf.adapter_verification(self._bundle)) != self._verification_bytes
+                or _freeze(self._read_contracts()) != self._contract_bytes):
+            raise ValueError("UNBAKING_PRIVATE_QUALIFICATION_REVOKED")
+
+    def step_status(self, step):
+        self._assert_current()
+        contract = self._contracts.get(step)
+        if contract is None:
+            return None
+        return {**copy.deepcopy(contract), "qualified": True, "missing": []}
+
+    def required_scope(self, scene, scope):
+        from .native_unbaking import validate_arguments
+        self._assert_current()
+        arguments = scope.get("operation_arguments")
+        validate_arguments(arguments)
+        if (scope.get("operation_name") != _OPERATION
+                or self.step_status(arguments["step"]) is None):
+            raise ValueError("UNBAKING_STEP_UNQUALIFIED")
+        required = self._leaf.required_scope(self._bundle, scene, scope)
+        if (not isinstance(required, dict) or required.get("operation_name") != _OPERATION
+                or required.get("operation_arguments") != arguments
+                or required.get("operation_arguments_digest") != guards.digest(arguments)
+                or required.get("validation_mode") == "qualified_update_boundary"):
+            # This first binding uses the existing full-projection source mode.
+            # A future Update-bound executor must perform current-source checks
+            # in its actual native callback before it can accept that mode.
+            raise ValueError("UNBAKING_SOURCE_CONTRACT_UNQUALIFIED")
+        return required
+
+    def capture(self, scene, scope):
+        self._assert_current()
+        self.required_scope(scene, scope)
+        return self._leaf.capture(self._bundle, scene, scope)
+
+    def execute(self, scene, arguments, request):
+        from . import native_unbaking
+        self._assert_current()
+        native_unbaking.validate_arguments(arguments)
+        if (getattr(guards._LOCAL, "request", None) is not request
+                or request.get("operations") != [{"name": _OPERATION, "arguments": arguments}]
+                or guards._ADAPTERS.get(_OPERATION) is not self):
+            raise ValueError("UNBAKING_REQUEST_CONTEXT_DIFFERS")
+        attempt = guards.current_adapter_attempt()
+        identity = guards.adapter_attempt_identity(attempt)
+        request_digest = guards.digest(request)
+        if (identity["request_digest"] != request_digest
+                or request_digest in self._consumed):
+            raise ValueError("UNBAKING_ATTEMPT_UNAVAILABLE")
+        contract = self.step_status(arguments["step"])
+        if contract is None:
+            raise ValueError("UNBAKING_STEP_UNQUALIFIED")
+        source = request.get("source_binding")
+        guards.assert_source(scene, source, operation_name=_OPERATION, arguments=arguments)
+        before = native_unbaking.capture_before(scene, arguments)
+        scene_before = dict(guards.scene_instance(scene))
+        # Validate/lower all SDK arguments without effects before consuming the
+        # attempt. The opaque prepared handle binds this exact request and scope.
+        prepared = self._leaf.prepare_step(self._bundle, scene, arguments, request, identity)
+        if (type(prepared) is not self._leaf.PreparedStep
+                or self._leaf.prepared_step_matches(self._bundle, prepared, scene, arguments, request, identity) is not True):
+            raise ValueError("UNBAKING_PREPARED_STEP_DIFFERS")
+        self._consumed.add(request_digest)
+        guards.before_write(lambda: guards.assert_source(scene, source,
+            operation_name=_OPERATION, arguments=arguments))
+        # The leaf must recheck admission at every selection/write boundary and
+        # cannot return a success handle while native work can still mutate.
+        # An exception keeps runtime.py's existing unknown/failure semantics.
+        completed = self._leaf.execute_step(self._bundle, prepared, attempt)
+        if type(completed) is not self._leaf.CompletedStep:
+            raise ValueError("UNBAKING_NATIVE_COMPLETION_HANDLE_UNAVAILABLE")
+        completion = self._leaf.consume_completed_step(self._bundle, completed, identity)
+        after = native_unbaking._read_projection(scene)
+        topology = native_unbaking.compare_projections(before, after, arguments)
+        scene_after = dict(guards.scene_instance(scene))
+        if (not isinstance(completion, dict)
+                or completion.get("step") != arguments["step"]
+                or completion.get("request_digest") != request_digest
+                or completion.get("operation_digest") != identity["operation_digest"]
+                or completion.get("original_source_digest") != identity["original_source_digest"]
+                or completion.get("runtime_epoch") != self._epoch
+                or completion.get("runtime_fingerprint") != self._fingerprint
+                or completion.get("installed_build") != _installed_build()
+                or completion.get("callback_generation") != identity["callback_generation"]
+                or completion.get("scene_before") != scene_before
+                or completion.get("scene_after") != scene_after or scene_after != scene_before
+                or completion.get("completion") != "completed"
+                or completion.get("postcondition") != "matched"
+                or completion.get("before_projection_digest") != guards.digest(before)
+                or completion.get("after_projection_digest") != guards.digest(after)
+                or completion.get("completion_contract_digest") != contract["completion_contract_digest"]
+                or completion.get("postcondition_contract_digest") != contract["postcondition_contract_digest"]
+                or not _sha(completion.get("native_trace_digest"))
+                or self._leaf.completed_step_is_current(self._bundle, completed, identity) is not True):
+            raise ValueError("UNBAKING_NATIVE_COMPLETION_UNVERIFIED")
+        self._assert_current()
+        guards.observe_effect(_OPERATION, "completed", scene_before=scene_before, scene_after=scene_after,
+            detail={"step": arguments["step"], "completion_contract_digest": contract["completion_contract_digest"],
+                    "native_trace_digest": completion["native_trace_digest"],
+                    "topology_observation": topology})
+        guards.finish_write()
+        return {"step": arguments["step"], "object_ids": arguments["object_ids"],
+            "layer_ids": arguments["layer_ids"], "interval": [arguments["first_frame"], arguments["last_frame"]],
+            "native_completion": "observed", "topology_observation": topology,
+            "completion_contract_digest": contract["completion_contract_digest"],
+            "native_trace_digest": completion["native_trace_digest"]}, []
+
+    def validate_failure_observation(self, scene, request, record_ref):
+        self._assert_current()
+        return self._leaf.validate_failure_observation(self._bundle, scene, request, record_ref)
+
+    def failure_observation_revoked(self, record_ref):
+        try:
+            self._assert_current()
+        except (ValueError, RuntimeError):
+            return True
+        return self._leaf.failure_observation_revoked(self._bundle, record_ref)
+
+
+def registered_adapter():
+    adapter = guards._ADAPTERS.get(_OPERATION)
+    return adapter if type(adapter) is _QualifiedUnbakingAdapter else None
+
+
+def install_after_native_qualification(qualification_handle):
+    """Called only by the future exact owned-fixture qualification helper.
+
+    The handle is process-private. No MCP handler, JSON loader, startup hook or
+    user flag calls this function. Importing this module performs no SDK action.
+    """
+    guards.assert_loaded_package()
+    if _OPERATION in guards._ADAPTERS:
+        raise ValueError("UNBAKING_ADAPTER_ALREADY_REGISTERED")
+    leaf = importlib.import_module(".native_installed_unbaking", __package__)
+    bundle = leaf.take_qualified_bundle(qualification_handle)
+    if type(bundle) is not leaf.QualifiedBundle:
+        raise ValueError("UNBAKING_PRIVATE_QUALIFICATION_HANDLE_UNAVAILABLE")
+    adapter = _QualifiedUnbakingAdapter(leaf, bundle)
+    guards.register_adapter(_OPERATION, adapter)
+    return {step: adapter.step_status(step) for step in sorted(adapter._contracts)}
