+"""Measured mesh fidelity between native output and the imported FBX surface.
+
+This compares canonical surfaces at observed frames. It does not align meshes,
+assume a common vertex order, certify topology, or infer continuous-time quality.
+"""
+from __future__ import annotations
+
+import heapq
+import math
+
+import numpy as np
+
+from .capture import canonical_digest
+from .models import SourceBinding
+from .motion_context import MotionContext, MotionInputError, SampleBatch, validate_samples
+from .motion_geometry import closest_triangle, load_native_geometry
+
+
+def _batch(value):
+    return SampleBatch(MotionContext.from_dict(value['context']), tuple(value['object_ids']), value['space'],
+        {key: np.asarray(item) for key, item in value['position_m'].items()},
+        {key: np.asarray(item) for key, item in value['rotation_wxyz'].items()},
+        {key: np.asarray(item, dtype=bool) for key, item in value['channel_valid'].items()},
+        SourceBinding.model_validate(value['source_binding']))
+
+
+def _mapping(profile):
+    settings = profile.target_import_settings
+    mapping = settings.native_mesh_mapping if settings is not None else None
+    if (not isinstance(mapping, dict) or set(mapping) != set(profile.mesh_refs)
+            or len(set(mapping.values())) != len(mapping)
+            or any(not isinstance(value, str) or not value for value in mapping.values())):
+        raise MotionInputError('EXPORT_NATIVE_MESH_MAPPING_UNAVAILABLE',
+            'Every exported mesh path needs a unique explicitly declared native stable mesh ID')
+    return mapping
+
+
+def _same_motion(native, before, required_mesh_ids):
+    """Match the code-owned whole-scene projection across operation scopes.
+
+    NativeSceneAdapter.capture() hashes the same complete read_scene projection
+    for evaluation and checkpoint. Their scope/content_revision hashes include
+    operation arguments and therefore cannot be used as cross-operation keys.
+    """
+    sources = []
+    for batch in (native, before):
+        # Follow capture coverage: positions for every requested ID, rotations
+        # only when actually supplied. Intent/quality retain their own required
+        # rotation obligations; this surface metric does not invent new ones.
+        required = {key: ('position', 'rotation') if key in batch.rotation_wxyz else ('position',)
+                    for key in batch.object_ids}
+        validate_samples(batch, required)
+        if (set(batch.position_m) != set(batch.object_ids) or set(batch.channel_valid) != set(batch.object_ids)
+                or not set(batch.rotation_wxyz) <= set(batch.object_ids)):
+            raise MotionInputError('INCOMPLETE_CAPTURE', 'Native motion channel maps escape their captured IDs')
+        source = SourceBinding.model_validate(batch.source_binding)
+        if (batch.space != 'global' or not source.complete
+                or source.scope.get('adapter_id') != 'native-model-assets-v1'
+                or not set(required_mesh_ids) <= set(source.scope.get('object_ids', ()))):
+            raise MotionInputError('EXPORT_NATIVE_MESH_SOURCE_UNVERIFIED', 'Complete native global source required')
+        sources.append(source)
+    identity = ('runtime_epoch', 'scene_instance_id', 'document_lineage_id')
+    if (any(getattr(sources[0].binding, key) != getattr(sources[1].binding, key) for key in identity)
+            or sources[0].sample_digest != sources[1].sample_digest
+            or sources[0].adapter_fingerprint != sources[1].adapter_fingerprint
+            or set(native.object_ids) != set(before.object_ids)):
+        raise MotionInputError('EXPORT_NATIVE_MESH_SOURCE_CHANGED',
+            'Geometry must belong to the exact final native source used by the pre-export motion capture')
+    for field in ('frames', 'time_s', 'scene_to_solver_basis'):
+        if not np.array_equal(getattr(native.context, field), getattr(before.context, field)):
+            raise MotionInputError('EXPORT_NATIVE_MESH_GRID_CHANGED', 'Native geometry and export grids differ')
+    if (native.context.fps_num, native.context.fps_den, native.context.metres_per_scene_unit) != (
+            before.context.fps_num, before.context.fps_den, before.context.metres_per_scene_unit):
+        raise MotionInputError('EXPORT_NATIVE_MESH_GRID_CHANGED', 'Native geometry and export conversion policies differ')
+    for field in ('position_m', 'rotation_wxyz', 'channel_valid'):
+        first, second = getattr(native, field), getattr(before, field)
+        if set(first) != set(second) or any(not np.array_equal(first[key], second[key]) for key in first):
+            raise MotionInputError('EXPORT_NATIVE_MESH_SOURCE_CHANGED', 'Final native motion changed after geometry capture')
+
+
+def _reference_geometry(reference, before_export, profile, verifier):
+    if (not isinstance(reference, dict) or reference.get('schema_version') != 1
+            or reference.get('before_export_digest') != canonical_digest(before_export.as_dict())):
+        raise MotionInputError('EXPORT_NATIVE_MESH_REFERENCE_UNAVAILABLE', 'Retained final mesh reference differs')
+    native_motion = _batch(reference['native_motion'])
+    _same_motion(native_motion, before_export, _mapping(profile).values())
+    sealed = reference['sealed_geometry']
+    manifest = sealed.get('manifest', {})
+    if manifest.get('motion_capture_digest') != canonical_digest(native_motion.as_dict()):
+        raise MotionInputError('EXPORT_NATIVE_MESH_SOURCE_UNVERIFIED', 'Native mesh is bound to a different motion capture')
+    maximum = reference.get('memory_budget_bytes')
+    if type(maximum) is not int or maximum <= 0:
+        raise MotionInputError('RESOURCE_BUDGET_EXCEEDED', 'Explicit native geometry window budget required')
+    geometry = load_native_geometry(sealed, context=native_motion.context, semantics='unsigned_surface',
+        verifier=verifier, memory_budget_bytes=maximum)
+    if not set(_mapping(profile).values()) <= set(geometry['tracks']):
+        raise MotionInputError('EXPORT_NATIVE_MESH_REFERENCE_UNAVAILABLE', 'A declared native mesh has no authenticated windows')
+    return geometry
+
+
+def make_mesh_delivery_reference(sealed, native_motion, before_export, profile, *, verifier, memory_budget_bytes):
+    """Retain native evidence before dispatching the one authorized export."""
+    reference = {'schema_version': 1, 'native_motion': native_motion.as_dict(),
+        'sealed_geometry': sealed, 'before_export_digest': canonical_digest(before_export.as_dict()),
+        'memory_budget_bytes': memory_budget_bytes}
+    _reference_geometry(reference, before_export, profile, verifier)
+    return reference
+
+
+class _DistanceBudget:
+    def __init__(self, maximum):
+        if type(maximum) is not int or maximum <= 0:
+            raise MotionInputError('RESOURCE_BUDGET_EXCEEDED', 'Explicit mesh distance-work budget required')
+        self.maximum, self.used = maximum, 0
+
+    def consume(self):
+        if self.used >= self.maximum:
+            raise MotionInputError('RESOURCE_BUDGET_EXCEEDED', 'Mesh distance-work budget exhausted; no quality pass issued')
+        self.used += 1
+
+
+def _nearest(point, surface, budget):
+    """Reuse the repository's BVH and point/triangle calculation with bounded work."""
+    pending = [(surface._bound(point, surface.root), surface.root)]
+    best = math.inf
+    while pending:
+        bound, index = heapq.heappop(pending)
+        if bound > best:
+            continue
+        _, _, ids, left, right = surface.nodes[index]
+        if ids is None:
+            for child in (left, right):
+                lower = surface._bound(point, child)
+                if lower <= best:
+                    heapq.heappush(pending, (lower, child))
+            continue
+        for triangle_id in ids:
+            budget.consume()
+            nearest, _ = closest_triangle(point, surface._geometry[triangle_id])
+            distance = float(np.dot(point - nearest, point - nearest))
+            best = min(best, distance)
+    if not math.isfinite(best):
+        raise MotionInputError('EXPORT_MESH_DISTANCE_UNAVAILABLE', 'No finite surface distance was measured')
+    return math.sqrt(best)
+
+
+def _samples(surface):
+    # Unreferenced vertices are not part of the rendered triangle surface.
+    for vertex in np.unique(surface.triangles.reshape(-1)):
+        yield 'vertex', int(vertex), surface.vertices[vertex]
+    for triangle_id, triangle in enumerate(surface._geometry):
+        yield 'triangle_centroid', triangle_id, triangle.mean(axis=0)
+
+
+def measure_mesh_delivery(reference, before_export, profile, target_tracks, *, verifier):
+    """Measure both directions in global metres; one frame pair is resident at a time."""
+    native = _reference_geometry(reference, before_export, profile, verifier)
+    mapping = _mapping(profile)
+    if set(target_tracks) != set(mapping):
+        raise MotionInputError('EXPORT_MESH_MAPPING_AMBIGUOUS', 'Imported mesh coverage differs from declared paths')
+    budget = _DistanceBudget(profile.target_import_settings.max_mesh_distance_checks)
+    count, total, maximum, worst = 0, 0., 0., None
+    for path, native_id in sorted(mapping.items()):
+        source_track, target_track = native['tracks'][native_id], target_tracks[path]
+        if (not np.array_equal(source_track.frames, before_export.context.frames)
+                or not np.array_equal(target_track.frames, before_export.context.frames)
+                or not np.array_equal(source_track.context.time_s, target_track.context.time_s)):
+            raise MotionInputError('EXPORT_NATIVE_MESH_GRID_CHANGED', 'Imported/native mesh times differ')
+        for row, frame in enumerate(before_export.context.frames):
+            source_surface, target_surface = source_track[row], target_track[row]
+            for direction, first, second in (('native_to_target', source_surface, target_surface),
+                                              ('target_to_native', target_surface, source_surface)):
+                for kind, index, point in _samples(first):
+                    distance = _nearest(point, second, budget)
+                    count += 1
+                    total += distance
+                    if worst is None or distance > maximum:
+                        maximum = distance
+                        worst = {'mesh_path': path, 'native_mesh_id': native_id, 'frame': int(frame),
+                            'direction': direction, 'sample_kind': kind, 'sample_index': index}
+            # Do not retain a second frame's BVH/geometry while loading the next.
+            del source_surface, target_surface, first, second
+    if not count:
+        raise MotionInputError('EXPORT_MESH_DISTANCE_UNAVAILABLE', 'No native/imported surface samples were measured')
+    limit = profile.tolerances.position_m
+    return {'status': 'measured', 'units': 'm', 'sample_count': count,
+        'max': maximum, 'mean': total / count, 'limit': limit, 'pass': maximum <= limit, 'worst': worst,
+        'coverage': 'sampled_frames_vertices_and_triangle_centroids',
+        'native_geometry_digest': reference['sealed_geometry']['geometry_digest'],
+        'native_motion_capture_digest': canonical_digest(reference['native_motion']),
+        'pre_export_capture_digest': reference['before_export_digest'],
+        'native_mesh_mapping': dict(mapping), 'triangle_distance_checks': budget.used,
+        'alignment_applied': False, 'continuous_time_verified': False,
+        'vertex_correspondence_verified': False, 'topology_equivalence_verified': False}
